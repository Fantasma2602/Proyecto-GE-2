--- !u!114 &1130611517
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1130611516}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fca1e73dd2f268c44a4a7939bdf97b13, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogos
  palabras:
  - nombre: Agnes
    dialogo: Hola joven El, Como estas?
    pers1: {fileID: 21300000, guid: ad7b59486df679e49a99cd9795fb8af3, type: 3}
    pers2: {fileID: 21300000, guid: 48dc32697e37d0743afe7d2f2d14d536, type: 3}
    caja: {fileID: 21300000, guid: 469f66e22c61f15448b21188a47184eb, type: 3}
  - nombre: El Condor
    dialogo: QUE ERES Y PORQUE PUEDES HABLAR?????
    pers1: {fileID: 21300000, guid: 48dc32697e37d0743afe7d2f2d14d536, type: 3}
    pers2: {fileID: 21300000, guid: ad7b59486df679e49a99cd9795fb8af3, type: 3}
    caja: {fileID: 21300000, guid: 469f66e22c61f15448b21188a47184eb, type: 3}
  - nombre: Agnes
    dialogo: Soy yo, Agnes Tachyon, tengo este aspecto por un experimento que salio
      mal...
    pers1: {fileID: 21300000, guid: ad7b59486df679e49a99cd9795fb8af3, type: 3}
    pers2: {fileID: 21300000, guid: 48dc32697e37d0743afe7d2f2d14d536, type: 3}
    caja: {fileID: 21300000, guid: 469f66e22c61f15448b21188a47184eb, type: 3}
  - nombre: El Condor
    dialogo: Otra vez..... No te habian dicho que dejaras de hacer experimentos raros?
    pers1: {fileID: 21300000, guid: 48dc32697e37d0743afe7d2f2d14d536, type: 3}
    pers2: {fileID: 21300000, guid: ad7b59486df679e49a99cd9795fb8af3, type: 3}
    caja: {fileID: 21300000, guid: 469f66e22c61f15448b21188a47184eb, type: 3}
  - nombre: Agnes
    dialogo: "Eso no es lo importante ahora, algunas de tus compa\xF1eras han perdido
      la razon e intentaran atacarte, asi que ten cuidado joven El"
    pers1: {fileID: 21300000, guid: ad7b59486df679e49a99cd9795fb8af3, type: 3}
    pers2: {fileID: 21300000, guid: 48dc32697e37d0743afe7d2f2d14d536, type: 3}
    caja: {fileID: 21300000, guid: 469f66e22c61f15448b21188a47184eb, type: 3}
